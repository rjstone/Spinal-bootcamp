// for format details, see https://aka.ms/vscode-remote/devcontainer.json
{
	"name": "Jupyter-SpinalHDL",
	"build": {
		"dockerfile": "./Dockerfile",
    "context": "."
	},
  "features": {
  },
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      "settings": {
        "jupyter.kernels.trusted": [
          "/home/vscode/.local/share/jupyter/kernels/scala"
        ],
        "jupyter.logKernelOutputSeparately": true
      },
      // Add the IDs of extensions you want installed
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "sam-the-programmer.jupyter-theme",
        "scala-lang.scala",
        "scalameta.metals",
        "scala-lang.scala-snippets"
      ]
    }
  },
	"remoteUser": "vscode"
}